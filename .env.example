# SQL Server (AdventureWorks2012)
# For Windows Authentication, set SQL_SERVER_HOST to server\instance name
SQL_SERVER_HOST=HELIOS\HELIOS
SQL_SERVER_PORT=1433
SQL_SERVER_DATABASE=AdventureWorks2012
SQL_SERVER_AUTH_MODE=windows
# Leave USERNAME and PASSWORD empty for Windows Authentication
SQL_SERVER_USERNAME=
SQL_SERVER_PASSWORD=
SQL_SERVER_DRIVER=ODBC Driver 17 for SQL Server

# PostgreSQL (Target Warehouse)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=adventureworks_warehouse
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SCHEMAS=bronze,silver,gold

# Application
LOG_LEVEL=INFO
DEBUG=False
ENVIRONMENT=development
RETRY_MAX_ATTEMPTS=3
RETRY_INITIAL_DELAY_SECONDS=1.0
RETRY_MAX_DELAY_SECONDS=30.0
BATCH_SIZE=10000
BRONZE_REJECTED_THRESHOLD=0
# Opt-in: SQL-side Silver dedup/validation on the Postgres staging table instead
# of in-memory pandas. Requires live-PostgreSQL integration evidence before
# enabling in production (see phase4c_silverlayer_execution.md 6.5.9/6.5.10).
SILVER_SQL_DEDUP_ENABLED=False
